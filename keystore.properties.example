# Copy to `keystore.properties` (gitignored) and fill in. Use the SAME keystore + key
# as the watch app — the Wear Data Layer requires a matching signature and Play uses one
# signing key per listing. See the watch repo's docs/play-store-packaging.md.

storeFile=/absolute/path/to/wearvian-upload.jks
storePassword=CHANGE_ME
keyAlias=wearvian
keyPassword=CHANGE_ME
